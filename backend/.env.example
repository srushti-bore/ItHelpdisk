# ==============================================================================
# NexAssist Enterprise IT Service Desk - Production Environment (.env.example)
# Configured specifically for: Render (Backend) + Vercel (Frontend) + Supabase (DB)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & SERVER CONFIGURATION (RENDER COMPATIBLE)
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=False
APP_NAME=NexAssist
API_V1_STR=/api/v1
# Render automatically injects dynamic port via $PORT
PORT=8000
HOST=0.0.0.0
PYTHON_VERSION=3.13.0

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL DATABASE (CLOUD PRODUCTION)
# ------------------------------------------------------------------------------
# Async Connection URL for FastAPI (Must use 'postgresql+asyncpg://')
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Synchronous Connection URL for Alembic Migrations (Must use 'postgresql://')
SYNC_DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. SECURITY & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
SECRET_KEY=replace_with_a_secure_32_character_hex_string_from_terminal
JWT_SECRET_KEY=replace_with_a_secure_32_character_hex_string_from_terminal
ALGORITHM=HS256
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase Project JWT Secret (From: Supabase -> Project Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_from_dashboard_here

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI AI CONFIGURATION
# ------------------------------------------------------------------------------
# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 5. SUPABASE STORAGE & S3 ATTACHMENTS
# ------------------------------------------------------------------------------
# From: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
SUPABASE_BUCKET_ATTACHMENTS=attachments

# ------------------------------------------------------------------------------
# 6. GOOGLE OAUTH 2.0 (GOOGLE SIGN-IN)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://nexassist-api.onrender.com/api/v1/auth/google/callback

# ------------------------------------------------------------------------------
# 7. BACKGROUND SCHEDULER ('THE SWEEP' - 24/7 SLA & RISK ENGINE)
# ------------------------------------------------------------------------------
SWEEP_INTERVAL_MINUTES=5
SLA_CHECK_ENABLED=True

# ------------------------------------------------------------------------------
# 8. CORS CONFIGURATION (ALLOW VERCEL FRONTEND & LOCAL RUNNERS)
# ------------------------------------------------------------------------------
CORS_ORIGINS=["https://nexassist.vercel.app","https://nexassist-*.vercel.app","http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000"]
FRONTEND_URL=https://nexassist.vercel.app
BACKEND_API_URL=https://nexassist-api.onrender.com

# ------------------------------------------------------------------------------
# 9. VERCEL FRONTEND (FLUTTER WEB) BUILD VARIABLES
# ------------------------------------------------------------------------------
# Pass this during Vercel Flutter Web build:
API_BASE_URL=https://nexassist-api.onrender.com/api/v1
