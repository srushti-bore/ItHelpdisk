# ==========================================
# AI IT Helpdesk — Environment Configuration
# ==========================================

# Environment: local | staging | production
ENVIRONMENT=local
DEBUG=true

# API & Security
PROJECT_NAME="AI IT Helpdesk"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-super-secret-high-entropy-jwt-key-minimum-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/it_helpdesk
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/it_helpdesk

# Supabase Storage & Project
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_STORAGE_BUCKET=attachments

# AI Provider (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth 2.0 / OIDC
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Email Notification Configuration
# Local dev: Gmail SMTP
GMAIL_SMTP_ADDRESS=your-gmail@gmail.com
GMAIL_SMTP_APP_PASSWORD=your-gmail-16-char-app-password

# Staging/Production: Brevo HTTP API
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM_ADDRESS=support@yourdomain.com
EMAIL_FROM_NAME="AI IT Helpdesk"

# Scheduled Sweeper Settings
SWEEP_INTERVAL_MINUTES=5
